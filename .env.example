# ---------------------------------------------------------------------------
# SENTINEL configuration. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------
APP_ENV=development

# Database: leave unset for zero-setup local SQLite (backend/sentinel.db).
# Docker Compose / Render use PostgreSQL, e.g.:
# DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel
DATABASE_URL=

# Optional Redis (multi-instance rate limiting). Leave empty for in-memory.
REDIS_URL=

# Auth: use a long random value in any shared deployment
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
JWT_EXPIRY_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Password for the seeded SYNTHETIC demo accounts (admin/reviewer/analyst/shoppers)
SEED_PASSWORD=SentinelDemo!2026
AUTO_SEED=true

# PayPal Sandbox REST app (developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook ID from the Sandbox app's webhook settings (required to verify webhooks)
PAYPAL_WEBHOOK_ID=

# Groq (optional). Without a key the agent uses a clearly labelled deterministic fallback.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

RATE_LIMIT_PER_MINUTE=120
